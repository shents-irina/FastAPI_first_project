# Виртуальные окружения Python
venv
.venv

# Настройки IDE
.idea
.vscode/

# Скомпилированный код Python
__pycache__

# Секреты и переменные окружения
.env
.env-test

# Служебные файлы macOS Finder
.DS_Store

# Загруженные пользователями картинки и их уменьшенные копии
src/static/images/*
!src/static/images/.gitkeep

# Локальное состояние расписания Celery Beat
celerybeat-schedule*
